{% set resource = hookable_metadata.context.resource %}
<div class="card mb-3">
    <div class="card-header">
        <h1 class="card-title">
            <i class="tabler:bell text-primary me-2"></i>
            {{ 'synolia_sylius_admin_notification.ui.notifications'|trans }} - {{ 'synolia_sylius_admin_notification.ui.admin.view'|trans({'%id%': resource.id}) }}
        </h1>
    </div>
    <div class="card-body">
        <table class="table table-borderless">
            <tbody>
                <tr>
                    <th scope="row">{{ 'sylius.ui.id'|trans }}</th>
                    <td>{{ resource.id }}</td>
                </tr>
                <tr>
                    <th scope="row">{{ 'sylius.ui.channel'|trans }}</th>
                    <td>{{ resource.channel }}</td>
                </tr>
                <tr>
                    <th scope="row">{{ 'synolia_sylius_admin_notification.ui.level_name'|trans }}</th>
                    <td>{{ resource.levelName }}</td>
                </tr>
                <tr>
                    <th scope="row">{{ 'synolia_sylius_admin_notification.ui.message'|trans }}</th>
                    <td>{{ resource.message }}</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
{% if resource.context is not null
    and (resource.context.content is defined and resource.context.content != '')
    or (resource.context.html is defined and resource.context.html != '')
%}
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">{{ 'synolia_sylius_admin_notification.ui.context'|trans }}</h2>
        </div>
        <div class="card-body">
            {% if resource.context.html is defined %}
                {{ resource.context.html|raw }}
            {% else %}
            <pre class="bg-light p-3 border rounded">{{ resource.context|serialize }}</pre>
            {% endif %}
        </div>
    </div>
{% endif %}
