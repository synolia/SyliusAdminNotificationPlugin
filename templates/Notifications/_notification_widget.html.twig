<div class="dropdown me-3" id="sylius-notification">
    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        {{ ux_icon('material-symbols:info-outline') }}
        {% if resources|length > 0 %}
            <span class="badge bg-red" style="transform: translate(-3px, -9px)"></span>
        {% endif %}
    </a>
    <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-0" style="min-width: 300px;">
        <li class="dropdown-header bg-light py-3 border-bottom rounded-top">
            <h6 class="mb-0">{{ 'synolia_sylius_admin_notification.ui.notifications'|trans }}</h6>
        </li>
        {% if resources|length == 0 %}
            <li class="p-3 text-center text-muted">
                {{ 'sylius.ui.no_new_notifications'|trans }}
            </li>
        {% else %}
            {% for notification in resources %}
                <li>
                    <a class="dropdown-item p-3 border-bottom" href="{{ path('synolia_sylius_admin_notification_admin_notification_show', {'id': notification.id}) }}">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge small">{{ notification.levelName }}</span>
                            <small class="text-muted">{{ notification.createdAt|date('d/m H:i') }}</small>
                        </div>
                        <div class="text-truncate small">{{ notification.message }}</div>
                    </a>
                </li>
            {% endfor %}
            <li class="text-center p-2 bg-light rounded-bottom">
                <a class="small text-decoration-none" href="{{ path('synolia_sylius_admin_notification_admin_notification_index') }}">
                    {{ 'synolia_sylius_admin_notification.ui.view_all'|trans }}
                </a>
            </li>
        {% endif %}
    </ul>
</div>
