{
    "name": "synolia/sylius-admin-notification-plugin",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "notification"
    ],
    "description": "Admin notifications for Sylius.",
    "license": "EUPL-1.2",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "sylius/sylius": "^2.0",
        "symfony/cache": "^6.4 || ^7.3 || ^8.0",
        "symfony/monolog-bundle": "^3.0 || ^4.0",
        "symfony/notifier": "^6.4 || ^7.3 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.9",
        "php-parallel-lint/php-parallel-lint": "^1.3",
        "phpmd/phpmd": "^3.0",
        "phpro/grumphp": "^2.5",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "povils/phpmnd": "^3.0",
        "squizlabs/php_codesniffer": "^3.7",
        "sylius/test-application": "^2.2@alpha",
        "symfony/browser-kit": "^6.4 || ^7.3 || ^8.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "symfony/thanks": true,
            "phpstan/extension-installer": true,
            "phpro/grumphp": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "Synolia\\SyliusAdminNotificationPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Synolia\\SyliusAdminNotificationPlugin\\": "tests/"
        }
    },
    "scripts": {
        "fix": "php-cs-fixer fix --config=ruleset/.php-cs-fixer.php",
        "grumphp": "grumphp run --ansi",
        "phpstan": "phpstan analyse -c ruleset/phpstan.neon --ansi",
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "php bin/create_node_symlink.php"
        ]
    },
    "extra": {
        "public-dir": "vendor/sylius/test-application/public"
    }
}
